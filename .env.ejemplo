# Copiar este archivo como .env (no se sube al repo) y completar los datos.
# Sin SMTP_HOST los mails se simulan: se registran en la consola y el QR queda en emails_enviados/.

# Gmail: requiere verificación en 2 pasos y una "contraseña de aplicación" de 16 letras.
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=587
SMTP_USUARIO=tu.cuenta@gmail.com
SMTP_CLAVE=contraseña-de-aplicacion
SMTP_REMITENTE=tu.cuenta@gmail.com
